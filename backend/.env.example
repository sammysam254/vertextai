# ==============================================
# CallPulse Backend Environment Variables
# Copy these to your Render environment or local .env
# ==============================================

NODE_ENV=production
PORT=5050
BASE_URL=https://vertext.site

# --- Supabase Database & Auth ---
SUPABASE_URL=https://xxxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# --- Redis Cache ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
# Or single connection URL on Render:
# REDIS_URL=redis://default:password@hostname:6379

# --- Twilio Voice & Phone Numbers ---
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_PHONE_NUMBER=+12513571708

# --- Groq AI Assistant ---
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
GROQ_MODEL=llama-3.1-8b-instant

# ==============================================
# In-App Wallet & Payment Gateway API Keys
# ==============================================

# Paystack (Card, M-Pesa, Bank Transfer, Mobile Money)
# Live secret key starts with sk_live_... (or sk_test_... for sandbox)
PAYSTACK_SECRET_KEY=YOUR_PAYSTACK_SECRET_KEY

# NOWPayments (Crypto: USDT, BTC, ETH, SOL, LTC)
# Get from NOWPayments Dashboard -> Settings -> API Keys
NOWPAYMENTS_API_KEY=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# NOWPayments IPN Secret (Webhook HMAC-SHA512 verification)
# Get from NOWPayments Dashboard -> Store Settings -> Instant Payment Notifications
NOWPAYMENTS_IPN_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- Security & Logging ---
JWT_SECRET=super-secret-jwt-key-change-in-production
LOG_LEVEL=info
MASK_PII_IN_LOGS=true
