{
  "name": "callpulse",
  "version": "1.0.0",
  "description": "AI-Powered Call Center & SMS SaaS Platform",
  "private": true,
  "workspaces": [
    "backend",
    "web"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=backend",
    "dev:web": "npm run dev --workspace=web",
    "dev:all": "concurrently \"npm run dev\" \"npm run dev:web\"",
    "build": "npm run build --workspace=backend",
    "build:web": "npm run build --workspace=web",
    "build:all": "npm run build && npm run build:web",
    "start": "npm start --workspace=backend",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm test --workspaces --if-present",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  }
}
